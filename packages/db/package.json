{
  "name": "@campusos/db",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "pnpm exec eslint src --max-warnings=0",
    "typecheck": "pnpm exec tsc --project tsconfig.json --noEmit",
    "test": "node -e \"console.log('No automated database tests defined yet.')\"",
    "build": "pnpm exec tsc --project tsconfig.json",
    "prisma:format": "pnpm exec prisma format",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate:dev": "pnpm exec prisma migrate dev"
  },
  "devDependencies": {
    "prisma": "^6.15.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}

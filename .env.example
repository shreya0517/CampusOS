# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_APP_NAME=CampusOS
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Backend
PORT=3001
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Required: generate a random value of at least 32 characters; never commit a real secret.
AUTH_ACCESS_TOKEN_SECRET=replace_with_a_long_random_secret_at_least_32_characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusos?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
AWS_REGION=ap-south-1
AWS_S3_BUCKET=campusos-local
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
